#[uniffi::export]
pub fn generate_path_challenge_tokens(session_key: Vec<u8>) -> PathChallengeResult {
    let (challenge_token, expected_response) =
        PathMigrationManager::create_path_challenge(&session_key);
    PathChallengeResult {
        challenge_token,
        expected_response,
    }
}

