<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- No ACCESS_FINE/COARSE_LOCATION and no Wi-Fi Direct permissions: the
         Wi-Fi Direct (P2P) feature was REMOVED (audit finding #1 — the group
         was never actually WPA2-secured and the join path was a dead stub),
         so NEARBY_WIFI_DEVICES / ACCESS_WIFI_STATE / CHANGE_WIFI_STATE /
         FOREGROUND_SERVICE_CONNECTED_DEVICE are no longer declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reboot recovery (audit finding #25): without a BOOT_COMPLETED path the
         service never restarted after a reboot until the app was opened, so a
         device that rebooted silently stopped syncing. The receiver only
         schedules the keepalive alarm — it does not start the foreground
         service directly (Android 12+ restricts FGS start from BOOT_COMPLETED).
         On boot, the alarm fires and PipeService's onStartCommand resumes the
         sync engine within the FGS rules. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- RECEIVE_SMS: intercepting inbound SMS for user-approved forwarding
         (default OFF, audit finding #14). SEND_SMS: used ONLY for the
         user-initiated outbound-reply flow (SmsApprovalReceiver approval
         notification), never for autonomous sending — audit finding F16. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="KyberPipe"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false"
        android:pageSizeCompat="enabled">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link Intent Filter for custom scheme -->
            <intent-filter android:label="KyberPipe Pair Link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kyberpipe" android:host="pair" />
            </intent-filter>

            <!-- App Link Intent Filter for clickable HTTPS links (e.g. Signal, WhatsApp, SMS).
                 autoVerify deliberately REMOVED (audit finding F16): auto-verified
                 HTTPS app links would make the pairing URL a web-triggerable vector;
                 the kyberpipe://pair scheme filter above remains the pairing entry. -->
            <intent-filter android:label="KyberPipe Pair Link HTTPS">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="brilliafy.github.io" />
                <data android:pathPrefix="/kyberpipe/pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PipeService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="KyberPipe post-quantum network synchronization engine" />
        </service>

        <service
            android:name=".receiver.NotificationHook"
            android:label="KyberPipe Notification Interceptor"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Android Quick Settings Tile Service -->
        <service
            android:name=".service.KyberTileService"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="KyberPipe PQC Core"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="false"
            android:permission="android.permission.BROADCAST_SMS">
            <!-- exported=false (system SMS broadcasts still reach it) and a modest
                 priority (audit finding F16) — no more abusing priority 1000 to
                 win the SMS race ahead of other receivers. -->
            <intent-filter android:priority="100">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.SmsApprovalReceiver"
            android:exported="false" />

        <!-- Reboot recovery (audit finding #25): schedules the sync keepalive
             alarm after a reboot so PipeService's onStartCommand resumes the
             sync engine without requiring the user to open the app. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
